[Unit]
Description=LGTV Linux Companion
Documentation=https://github.com/moorknet/LGTVLinuxCompanion
# The daemon needs the graphical session for Wayland idle detection, and it
# talks to the TV over the network.
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=notify
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/lgtv-companion-daemon
Restart=on-failure
RestartSec=5

# The TV must be told to power off before the system goes down. logind grants
# a delay inhibitor of InhibitDelayMaxSec (5s by default); give systemd room to
# let that handler finish before it starts killing us.
TimeoutStopSec=20

# Hardening. The daemon only needs its XDG directories and the network.
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=graphical-session.target
